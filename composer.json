{
    "name": "vtech9nl/filament-polder-theme",
    "description": "Polder: an inset-layout theme for Filament panels, with light and dark mode and an optional compact density",
    "keywords": [
        "filament",
        "filament-plugin",
        "filament-theme",
        "laravel",
        "theme"
    ],
    "homepage": "https://github.com/VTech9NL/filament-polder-theme",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Yaniv Harush",
            "email": "harushy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "VTech9NL\\PolderTheme\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VTech9NL\\PolderTheme\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VTech9NL\\PolderTheme\\PolderThemeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
